rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // مسموح فقط للمستخدمين المسجلين. للتشديد أكثر استبدل الشرط بقائمة إيميلات:
      // allow read, write: if request.auth != null && request.auth.token.email in ['you@company.com'];
      allow read, write: if request.auth != null;
    }
  }
}
